# SyncStream Environment Variables Example

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
# Port the Spring Boot application will run on
PORT=8080

# MongoDB URI (MongoDB Atlas in Production, mongodb://localhost:27017/syncstream in local docker)
MONGODB_URI=mongodb://localhost:27017/syncstream

# Redis Server Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security (HMAC-SHA 256-bit key)
JWT_SECRET=5573796e6353747265616d53757065725365637265744b65793230323623
JWT_EXPIRATION=86400000

# CORS Allowed Origin (Vercel Frontend URL in Production, http://localhost:5173 in local dev)
FRONTEND_URL=http://localhost:5173


# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# Vite dev server proxy or API base endpoint
VITE_API_BASE_URL=http://localhost:8080

# WebSocket connection URL for STOMP client
VITE_WS_URL=ws://localhost:8080/ws
